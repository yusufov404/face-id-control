# FaceSys Enterprise — environment template
# COPY to .env and change EVERY secret before deployment.
# NEVER commit the real .env file.

APP_NAME=FaceSys Enterprise
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
TIMEZONE=Asia/Tashkent

HOST=0.0.0.0
PORT=8000
# Keep 1: the Hikvision poller starts inside the app lifespan. Multiple workers
# would poll every device multiple times.
WORKERS=1

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=facesys
DATABASE_USER=facesys
DATABASE_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_byte_random_string_before_deploy
REFRESH_SECRET_KEY=CHANGE_ME_generate_a_different_64_byte_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ALGORITHM=argon2
BCRYPT_ROUNDS=12

# --- Session / cookies (reserved; auth uses bearer tokens, not cookies) ---
SESSION_COOKIE_NAME=facesys_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# --- Rate limiting ---
# Only the login endpoint is limited in this version. API_RATE_LIMIT is
# reserved and currently not enforced.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW=300
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60

# --- CORS (JSON list; local network only) ---
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# --- Hikvision ---
# The poller uses per-device timeout/sync_interval from the device record.
# These values are reserved for future HTTP retry logic.
HIKVISION_TIMEOUT=10
HIKVISION_RETRY_ATTEMPTS=3
HIKVISION_RETRY_DELAY=5
HIKVISION_SYNC_INTERVAL=300
HIKVISION_EVENT_BUFFER_SIZE=1000

# --- Backups (the daily schedule is provided by facesys-backup.timer) ---
BACKUP_DIR_SSD=/var/backups/facesys/ssd
BACKUP_DIR_HDD=/mnt/backup_hdd/facesys
BACKUP_HDD_MOUNT=/mnt/backup_hdd
BACKUP_RETENTION_DAYS_SSD=7
BACKUP_RETENTION_DAYS_HDD=90
BACKUP_SCHEDULE=0 2 * * *

# --- Audit ---
AUDIT_LOG_RETENTION_DAYS=365

# --- Pagination / export ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
EXPORT_MAX_ROWS=10000